{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024"],
        "types": ["@cloudflare/workers-types"],
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["functions/**/*.js", "functions/**/*.d.ts"]
}
